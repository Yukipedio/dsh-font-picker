{
  "name": "dsh-font-picker",
  "version": "2.4.1",
  "description": "Lists the fonts installed on this machine and writes the picked family into the native DSH font settings (Settings → General → Fonts).",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "fonts",
    "font-picker"
  ],
  "homepage": "https://github.com/Yukipedio/dsh-font-picker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yukipedio/dsh-font-picker.git"
  },
  "bugs": {
    "url": "https://github.com/Yukipedio/dsh-font-picker/issues"
  },
  "author": "Yukipedio",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "README.ja.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
